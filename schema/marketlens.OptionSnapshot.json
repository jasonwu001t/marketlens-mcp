{
  "$defs": {
    "AbsenceCode": {
      "description": "Why a value is None. Never served as 0.",
      "enum": [
        "not_provided_by_source",
        "not_applicable",
        "not_entitled",
        "no_data",
        "insufficient_data",
        "not_recovered",
        "no_match",
        "withheld",
        "source_error",
        "unparseable"
      ],
      "title": "AbsenceCode",
      "type": "string"
    },
    "OptionType": {
      "enum": [
        "call",
        "put"
      ],
      "title": "OptionType",
      "type": "string"
    }
  },
  "$id": "urn:marketlens:schema:1:marketlens.OptionSnapshot",
  "additionalProperties": false,
  "description": "Latest state of one contract with greeks and implied volatility (the\nrows of options_snapshots and options_chain). Expiration, strike and type\nare parsed from the OCC symbol. day_* come from the contract's latest daily\nbar, which is an earlier session than today's for a contract that has not\ntraded today (day_t dates it), and prev_close from the bar before that\n(prev_t). Greeks are the provider's, per share:\ndelta per 1.00 move of the underlying, gamma per 1.00 move squared, theta\nin premium per calendar day, vega in premium per 1 point (0.01) of IV, rho\nin premium per 1 point (0.01) of rate. ml-alpaca verifies these conventions\nagainst Alpaca's documentation and corrects the descriptions if they differ.",
  "properties": {
    "absent": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/AbsenceCode"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Per-row reasons for None fields: field name -> AbsenceCode",
      "title": "Absent"
    },
    "ask_price": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ask Price",
      "x-unit": "price"
    },
    "ask_size": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ask Size",
      "x-unit": "contracts"
    },
    "bid_price": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Bid Price",
      "x-unit": "price"
    },
    "bid_size": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Bid Size",
      "x-unit": "contracts"
    },
    "currency": {
      "default": "USD",
      "title": "Currency",
      "type": "string"
    },
    "day_close": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Day Close",
      "x-unit": "price"
    },
    "day_high": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Day High",
      "x-unit": "price"
    },
    "day_low": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Day Low",
      "x-unit": "price"
    },
    "day_open": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Day Open",
      "x-unit": "price"
    },
    "day_t": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Start of the daily bar day_open..day_volume come from (00:00 New York of its session): the contract's latest daily bar, an earlier session than today's when it has not traded today",
      "title": "Day T",
      "x-unit": "UTC"
    },
    "day_volume": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Day Volume",
      "x-unit": "contracts"
    },
    "delta": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Delta",
      "x-unit": "per_share_greek"
    },
    "expiration_date": {
      "format": "date",
      "title": "Expiration Date",
      "type": "string"
    },
    "gamma": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Gamma",
      "x-unit": "per_share_greek"
    },
    "implied_volatility": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Implied Volatility",
      "x-unit": "fraction_per_year"
    },
    "last_price": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Price",
      "x-unit": "price"
    },
    "last_size": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Size",
      "x-unit": "contracts"
    },
    "last_t": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last T",
      "x-unit": "UTC"
    },
    "occ_symbol": {
      "pattern": "^(?P<root>[A-Z][A-Z0-9]{0,5})(?P<yymmdd>\\d{6})(?P<cp>[CP])(?P<strike>\\d{8})$",
      "title": "Occ Symbol",
      "type": "string"
    },
    "open_interest": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Open contracts as of open_interest_date (options_chain only)",
      "title": "Open Interest",
      "x-unit": "contracts"
    },
    "open_interest_date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The date of the open interest count. Open interest is published the next morning, so this is usually the trading day before day_t",
      "title": "Open Interest Date"
    },
    "option_type": {
      "$ref": "#/$defs/OptionType"
    },
    "prev_close": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prev Close",
      "x-unit": "price"
    },
    "prev_t": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Start of the daily bar prev_close comes from: the one before day_t",
      "title": "Prev T",
      "x-unit": "UTC"
    },
    "quote_t": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Quote T",
      "x-unit": "UTC"
    },
    "rho": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rho",
      "x-unit": "per_share_greek"
    },
    "strike": {
      "title": "Strike",
      "type": "number",
      "x-unit": "price"
    },
    "t": {
      "description": "The newest timestamp among the snapshot's parts",
      "format": "date-time",
      "title": "T",
      "type": "string",
      "x-unit": "UTC"
    },
    "theta": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Theta",
      "x-unit": "per_share_greek"
    },
    "underlying": {
      "pattern": "^(?:[A-Z][A-Z0-9]{0,9}(?:-[A-Z0-9]{1,5})?|[A-Z0-9]{2,10}/[A-Z0-9]{2,10})$",
      "title": "Underlying",
      "type": "string"
    },
    "vega": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Vega",
      "x-unit": "per_share_greek"
    }
  },
  "required": [
    "occ_symbol",
    "underlying",
    "expiration_date",
    "strike",
    "option_type",
    "t"
  ],
  "title": "OptionSnapshot",
  "type": "object",
  "x-schema-version": "1.1.0"
}
