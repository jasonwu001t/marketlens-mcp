{
  "$defs": {
    "AbsenceCode": {
      "description": "Why a value is None. Never served as 0.",
      "enum": [
        "not_provided_by_source",
        "not_applicable",
        "not_entitled",
        "no_data",
        "insufficient_data",
        "not_recovered",
        "no_match",
        "withheld",
        "source_error",
        "unparseable"
      ],
      "title": "AbsenceCode",
      "type": "string"
    }
  },
  "$id": "urn:marketlens:schema:1:marketlens.EconomicObservation",
  "additionalProperties": false,
  "description": "One observation of an economic series (FRED/ALFRED, BLS or a BEA NIPA line).",
  "properties": {
    "absent": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/AbsenceCode"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Per-row reasons for None fields: field name -> AbsenceCode",
      "title": "Absent"
    },
    "date": {
      "description": "First day of the period the value describes",
      "format": "date",
      "title": "Date",
      "type": "string"
    },
    "frequency": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "A, Q or M where the source states it",
      "title": "Frequency"
    },
    "knowledge_time": {
      "description": "When the value became knowable under the dataset's point-in-time policy",
      "format": "date-time",
      "title": "Knowledge Time",
      "type": "string",
      "x-unit": "UTC"
    },
    "line_number": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "BEA table line",
      "title": "Line Number",
      "x-unit": "ordinal"
    },
    "period": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Publisher's period code: M01..M12, Q1..Q4 or A (None for FRED)",
      "title": "Period"
    },
    "pit": {
      "description": "vintage: the value as published at knowledge_time; lagged: release-lag approximation",
      "enum": [
        "vintage",
        "lagged"
      ],
      "title": "Pit",
      "type": "string"
    },
    "series_id": {
      "description": "FRED or BLS series id; a BEA line's series code",
      "title": "Series Id",
      "type": "string"
    },
    "source": {
      "enum": [
        "fred",
        "bls",
        "bea"
      ],
      "title": "Source",
      "type": "string"
    },
    "table_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "BEA NIPA table, e.g. T10101",
      "title": "Table Name"
    },
    "title": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Series name (FRED catalogue) or BEA line description",
      "title": "Title"
    },
    "units": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The publisher's unit for `value`",
      "title": "Units"
    },
    "value": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "In the row's `units`",
      "title": "Value",
      "x-unit": "as_published"
    }
  },
  "required": [
    "source",
    "series_id",
    "date",
    "knowledge_time",
    "pit"
  ],
  "title": "EconomicObservation",
  "type": "object",
  "x-schema-version": "1.1.0"
}
