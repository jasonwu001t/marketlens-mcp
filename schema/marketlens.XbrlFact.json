{
  "$defs": {
    "AbsenceCode": {
      "description": "Why a value is None. Never served as 0.",
      "enum": [
        "not_provided_by_source",
        "not_applicable",
        "not_entitled",
        "no_data",
        "insufficient_data",
        "not_recovered",
        "no_match",
        "withheld",
        "source_error",
        "unparseable"
      ],
      "title": "AbsenceCode",
      "type": "string"
    }
  },
  "$id": "urn:marketlens:schema:1:marketlens.XbrlFact",
  "additionalProperties": false,
  "description": "One XBRL fact from EDGAR company facts, as filed.",
  "properties": {
    "absent": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/AbsenceCode"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Per-row reasons for None fields: field name -> AbsenceCode",
      "title": "Absent"
    },
    "accession_number": {
      "title": "Accession Number",
      "type": "string"
    },
    "cik": {
      "title": "Cik",
      "type": "string"
    },
    "fiscal_period": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Q1..Q4 or FY",
      "title": "Fiscal Period"
    },
    "fiscal_year": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fiscal Year"
    },
    "form": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Form"
    },
    "knowledge_time": {
      "description": "When the value became knowable under the dataset's point-in-time policy",
      "format": "date-time",
      "title": "Knowledge Time",
      "type": "string",
      "x-unit": "UTC"
    },
    "metric": {
      "description": "The XBRL concept, verbatim (Revenues, NetIncomeLoss, ...)",
      "title": "Metric",
      "type": "string"
    },
    "period_end": {
      "format": "date",
      "title": "Period End",
      "type": "string"
    },
    "period_start": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Period Start"
    },
    "taxonomy": {
      "description": "us-gaap, dei, ifrs-full, srt, ...",
      "title": "Taxonomy",
      "type": "string"
    },
    "ticker": {
      "title": "Ticker",
      "type": "string"
    },
    "unit": {
      "description": "The fact's unit: USD, USD/shares, shares, pure, ...",
      "title": "Unit",
      "type": "string"
    },
    "value": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "In the row's `unit`",
      "title": "Value",
      "x-unit": "as_published"
    }
  },
  "required": [
    "ticker",
    "cik",
    "taxonomy",
    "metric",
    "unit",
    "period_end",
    "accession_number",
    "knowledge_time"
  ],
  "title": "XbrlFact",
  "type": "object",
  "x-schema-version": "1.1.0"
}
