  "properties": {
    "absent": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/AbsenceCode"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Per-row reasons for None fields: field name -> AbsenceCode",
      "title": "Absent"
    },
    "breakdown": {
      "description": "Trade type, or 'years to maturity | benchmark', or empty",
      "title": "Breakdown",
      "type": "string"
    },
    "date": {
