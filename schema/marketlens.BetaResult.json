{
  "$defs": {
    "AbsenceCode": {
      "description": "Why a value is None. Never served as 0.",
      "enum": [
        "not_provided_by_source",
        "not_applicable",
        "not_entitled",
        "no_data",
        "insufficient_data",
        "not_recovered",
        "no_match",
        "withheld",
        "source_error",
        "unparseable"
      ],
      "title": "AbsenceCode",
      "type": "string"
    }
  },
  "$id": "urn:marketlens:schema:1:marketlens.BetaResult",
  "additionalProperties": false,
  "properties": {
    "absent": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/AbsenceCode"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Per-row reasons for None fields: field name -> AbsenceCode",
      "title": "Absent"
    },
    "alpha": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Per period: mean(r_a) - beta x mean(r_b)",
      "title": "Alpha",
      "x-unit": "fraction"
    },
    "benchmark": {
      "title": "Benchmark",
      "type": "string"
    },
    "beta": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "cov_samp(r_a, r_b) / var_samp(r_b)",
      "title": "Beta",
      "x-unit": "fraction"
    },
    "end": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "End",
      "x-unit": "UTC"
    },
    "n_obs": {
      "title": "N Obs",
      "type": "integer",
      "x-unit": "count"
    },
    "period": {
      "anyOf": [
        {
          "pattern": "^(?:(?:[1-9]|[1-5][0-9])min|(?:[1-9]|1[0-9]|2[0-3])h|1d|1w|(?:1|2|3|4|6|12)mo)$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Period"
    },
    "r_squared": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "R Squared",
      "x-unit": "fraction"
    },
    "return_kind": {
      "enum": [
        "simple",
        "log"
      ],
      "title": "Return Kind",
      "type": "string"
    },
    "series": {
      "title": "Series",
      "type": "string"
    },
    "start": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Start",
      "x-unit": "UTC"
    }
  },
  "required": [
    "series",
    "benchmark",
    "n_obs",
    "return_kind"
  ],
  "title": "BetaResult",
  "type": "object",
  "x-schema-version": "1.1.0"
}
