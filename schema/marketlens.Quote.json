{
  "$defs": {
    "AbsenceCode": {
      "description": "Why a value is None. Never served as 0.",
      "enum": [
        "not_provided_by_source",
        "not_applicable",
        "not_entitled",
        "no_data",
        "insufficient_data",
        "not_recovered",
        "no_match",
        "withheld",
        "source_error",
        "unparseable"
      ],
      "title": "AbsenceCode",
      "type": "string"
    },
    "AssetClass": {
      "enum": [
        "us_equity",
        "us_option",
        "crypto",
        "fixed_income"
      ],
      "title": "AssetClass",
      "type": "string"
    }
  },
  "$id": "urn:marketlens:schema:1:marketlens.Quote",
  "additionalProperties": false,
  "properties": {
    "absent": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/AbsenceCode"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Per-row reasons for None fields: field name -> AbsenceCode",
      "title": "Absent"
    },
    "ask_exchange": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ask Exchange"
    },
    "ask_price": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ask Price",
      "x-unit": "price"
    },
    "ask_size": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ask Size",
      "x-unit": "by_asset_class"
    },
    "asset_class": {
      "$ref": "#/$defs/AssetClass"
    },
    "bid_exchange": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Bid Exchange"
    },
    "bid_price": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Bid Price",
      "x-unit": "price"
    },
    "bid_size": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Shares (stocks) or base units (crypto). If a feed reports round lots, the adapter converts to shares and says so in the tool description",
      "title": "Bid Size",
      "x-unit": "by_asset_class"
    },
    "conditions": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Conditions"
    },
    "currency": {
      "default": "USD",
      "title": "Currency",
      "type": "string"
    },
    "t": {
      "format": "date-time",
      "title": "T",
      "type": "string",
      "x-unit": "UTC"
    },
    "tape": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tape"
    },
    "ticker": {
      "pattern": "^(?:[A-Z][A-Z0-9]{0,9}(?:-[A-Z0-9]{1,5})?|[A-Z0-9]{2,10}/[A-Z0-9]{2,10})$",
      "title": "Ticker",
      "type": "string"
    }
  },
  "required": [
    "ticker",
    "asset_class",
    "t"
  ],
  "title": "Quote",
  "type": "object",
  "x-schema-version": "1.1.0"
}
