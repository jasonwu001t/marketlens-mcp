{
  "$defs": {
    "AbsenceCode": {
      "description": "Why a value is None. Never served as 0.",
      "enum": [
        "not_provided_by_source",
        "not_applicable",
        "not_entitled",
        "no_data",
        "insufficient_data",
        "not_recovered",
        "no_match",
        "withheld",
        "source_error",
        "unparseable"
      ],
      "title": "AbsenceCode",
      "type": "string"
    }
  },
  "$id": "urn:marketlens:schema:1:marketlens.IrDocument",
  "additionalProperties": false,
  "description": "One company-published document the operator lists for a ticker (an\ninvestor-day release, an outlook, a letter): its text (UNTRUSTED) and sha,\nserved from EDGAR (authority official) when the company also filed it.",
  "properties": {
    "absent": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/AbsenceCode"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Per-row reasons for None fields: field name -> AbsenceCode",
      "title": "Absent"
    },
    "authority": {
      "description": "official when the EDGAR copy is served, else company (the company's own site)",
      "enum": [
        "official",
        "company"
      ],
      "title": "Authority",
      "type": "string"
    },
    "cik": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cik"
    },
    "content_type": {
      "description": "html, pdf or text, of the served copy",
      "title": "Content Type",
      "type": "string"
    },
    "document_url": {
      "title": "Document Url",
      "type": "string"
    },
    "edgar_accession": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Edgar Accession"
    },
    "edgar_form": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Edgar Form"
    },
    "kind": {
      "description": "investor_day, outlook, letter or presentation",
      "title": "Kind",
      "type": "string"
    },
    "knowledge_time": {
      "description": "When the value became knowable under the dataset's point-in-time policy",
      "format": "date-time",
      "title": "Knowledge Time",
      "type": "string",
      "x-role": "available",
      "x-unit": "UTC"
    },
    "published": {
      "format": "date",
      "title": "Published",
      "type": "string"
    },
    "served_url": {
      "title": "Served Url",
      "type": "string"
    },
    "sha256": {
      "title": "Sha256",
      "type": "string"
    },
    "text": {
      "description": "The served copy's text, capped (untrusted text)",
      "title": "Text",
      "type": "string"
    },
    "text_chars": {
      "description": "The text's length before the cap",
      "title": "Text Chars",
      "type": "integer",
      "x-unit": "count"
    },
    "ticker": {
      "title": "Ticker",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "truncated": {
      "title": "Truncated",
      "type": "boolean"
    }
  },
  "required": [
    "ticker",
    "document_url",
    "published",
    "kind",
    "title",
    "authority",
    "served_url",
    "content_type",
    "sha256",
    "text",
    "text_chars",
    "truncated",
    "knowledge_time"
  ],
  "title": "IrDocument",
  "type": "object",
  "x-schema-version": "1.1.0"
}
