{
  "$defs": {
    "AbsenceCode": {
      "description": "Why a value is None. Never served as 0.",
      "enum": [
        "not_provided_by_source",
        "not_applicable",
        "not_entitled",
        "no_data",
        "insufficient_data",
        "not_recovered",
        "no_match",
        "withheld",
        "source_error",
        "unparseable"
      ],
      "title": "AbsenceCode",
      "type": "string"
    },
    "AssetClass": {
      "enum": [
        "us_equity",
        "us_option",
        "crypto",
        "fixed_income"
      ],
      "title": "AssetClass",
      "type": "string"
    }
  },
  "$id": "urn:marketlens:schema:1:marketlens.OrderBookLevel",
  "additionalProperties": false,
  "description": "One price level of a crypto order book; level 0 is the best price.",
  "properties": {
    "absent": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/AbsenceCode"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Per-row reasons for None fields: field name -> AbsenceCode",
      "title": "Absent"
    },
    "asset_class": {
      "$ref": "#/$defs/AssetClass"
    },
    "currency": {
      "default": "USD",
      "title": "Currency",
      "type": "string"
    },
    "level": {
      "minimum": 0,
      "title": "Level",
      "type": "integer"
    },
    "price": {
      "title": "Price",
      "type": "number",
      "x-unit": "price"
    },
    "side": {
      "enum": [
        "bid",
        "ask"
      ],
      "title": "Side",
      "type": "string"
    },
    "size": {
      "title": "Size",
      "type": "number",
      "x-unit": "base_units"
    },
    "t": {
      "format": "date-time",
      "title": "T",
      "type": "string",
      "x-unit": "UTC"
    },
    "ticker": {
      "pattern": "^(?:[A-Z][A-Z0-9]{0,9}(?:-[A-Z0-9]{1,5})?|[A-Z0-9]{2,10}/[A-Z0-9]{2,10})$",
      "title": "Ticker",
      "type": "string"
    }
  },
  "required": [
    "ticker",
    "asset_class",
    "t",
    "side",
    "level",
    "price",
    "size"
  ],
  "title": "OrderBookLevel",
  "type": "object",
  "x-schema-version": "1.0.0"
}
