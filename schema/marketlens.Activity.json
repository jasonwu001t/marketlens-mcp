{
  "$defs": {
    "AbsenceCode": {
      "description": "Why a value is None. Never served as 0.",
      "enum": [
        "not_provided_by_source",
        "not_applicable",
        "not_entitled",
        "no_data",
        "insufficient_data",
        "not_recovered",
        "no_match",
        "withheld",
        "source_error",
        "unparseable"
      ],
      "title": "AbsenceCode",
      "type": "string"
    },
    "Environment": {
      "description": "Which brokerage account a portfolio read came from.",
      "enum": [
        "paper",
        "live"
      ],
      "title": "Environment",
      "type": "string"
    },
    "OrderStatus": {
      "enum": [
        "new",
        "partially_filled",
        "filled",
        "done_for_day",
        "canceled",
        "expired",
        "replaced",
        "pending_cancel",
        "pending_replace",
        "pending_review",
        "accepted",
        "pending_new",
        "accepted_for_bidding",
        "stopped",
        "rejected",
        "suspended",
        "calculated",
        "held"
      ],
      "title": "OrderStatus",
      "type": "string"
    },
    "Side": {
      "enum": [
        "buy",
        "sell"
      ],
      "title": "Side",
      "type": "string"
    }
  },
  "$id": "urn:marketlens:schema:1:marketlens.Activity",
  "additionalProperties": false,
  "description": "One account activity: a fill (category trade) or a non-trade event\n(dividend, fee, transfer, corporate action, ...).",
  "properties": {
    "absent": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/AbsenceCode"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Per-row reasons for None fields: field name -> AbsenceCode",
      "title": "Absent"
    },
    "activity_id": {
      "title": "Activity Id",
      "type": "string"
    },
    "activity_type": {
      "description": "The provider's activity code, e.g. FILL, DIV, FEE, CSD, JNLC",
      "title": "Activity Type",
      "type": "string"
    },
    "category": {
      "enum": [
        "trade",
        "non_trade"
      ],
      "title": "Category",
      "type": "string"
    },
    "cum_qty": {
      "anyOf": [
        {
          "pattern": "^-?\\d+(\\.\\d+)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cum Qty",
      "x-unit": "by_asset_class"
    },
    "currency": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Currency"
    },
    "date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Date"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "environment": {
      "$ref": "#/$defs/Environment"
    },
    "leaves_qty": {
      "anyOf": [
        {
          "pattern": "^-?\\d+(\\.\\d+)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Leaves Qty",
      "x-unit": "by_asset_class"
    },
    "net_amount": {
      "anyOf": [
        {
          "pattern": "^-?\\d+(\\.\\d+)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Net Amount",
      "x-unit": "USD"
    },
    "occ_symbol": {
      "anyOf": [
        {
          "pattern": "^(?P<root>[A-Z]{1,6})(?P<yymmdd>\\d{6})(?P<cp>[CP])(?P<strike>\\d{8})$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Occ Symbol"
    },
    "order_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Order Id"
    },
    "order_status": {
      "anyOf": [
        {
          "$ref": "#/$defs/OrderStatus"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "per_share_amount": {
      "anyOf": [
        {
          "pattern": "^-?\\d+(\\.\\d+)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Per Share Amount",
      "x-unit": "USD"
    },
    "price": {
      "anyOf": [
        {
          "pattern": "^-?\\d+(\\.\\d+)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Price",
      "x-unit": "USD"
    },
    "qty": {
      "anyOf": [
        {
          "pattern": "^-?\\d+(\\.\\d+)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Qty",
      "x-unit": "by_asset_class"
    },
    "side": {
      "anyOf": [
        {
          "$ref": "#/$defs/Side"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "status": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Status"
    },
    "t": {
      "description": "Transaction time; a date-only activity is placed at 00:00 UTC of its date (see `date`)",
      "format": "date-time",
      "title": "T",
      "type": "string",
      "x-unit": "UTC"
    },
    "ticker": {
      "anyOf": [
        {
          "pattern": "^(?:[A-Z][A-Z0-9]{0,9}(?:-[A-Z0-9]{1,5})?|[A-Z0-9]{2,10}/[A-Z0-9]{2,10})$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ticker"
    }
  },
  "required": [
    "environment",
    "activity_id",
    "activity_type",
    "category",
    "t"
  ],
  "title": "Activity",
  "type": "object",
  "x-schema-version": "1.1.0"
}
