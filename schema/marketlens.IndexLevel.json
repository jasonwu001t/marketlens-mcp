      "title": "Close",
      "x-unit": "as_published"
    },
    "date": {
      "description": "The session's date (the exchange's local date)",
      "format": "date",
      "title": "Date",
      "type": "string"
    },
    "high": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "In the row's `unit`",
      "title": "High",
      "x-unit": "as_published"
    },
    "index": {
      "description": "The index, e.g. TAIEX",
      "title": "Index",
      "type": "string"
    },
    "knowledge_time": {
      "description": "When the value became knowable under the dataset's point-in-time policy",
