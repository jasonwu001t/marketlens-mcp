{
  "$defs": {
    "AbsenceCode": {
      "description": "Why a value is None. Never served as 0.",
      "enum": [
        "not_provided_by_source",
        "not_applicable",
        "not_entitled",
        "no_data",
        "insufficient_data",
        "not_recovered",
        "no_match",
        "withheld",
        "source_error",
        "unparseable"
      ],
      "title": "AbsenceCode",
      "type": "string"
    }
  },
  "$id": "urn:marketlens:schema:1:marketlens.IndexLevel",
  "additionalProperties": false,
  "description": "One session of a stock index as its exchange states it: the open, high,\nlow and close in index points (TAIEX: the Taiwan Stock Exchange's\ncapitalization-weighted index).",
