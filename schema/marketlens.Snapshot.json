{
  "$defs": {
    "AbsenceCode": {
      "description": "Why a value is None. Never served as 0.",
      "enum": [
        "not_provided_by_source",
        "not_applicable",
        "not_entitled",
        "no_data",
        "insufficient_data",
        "not_recovered",
        "no_match",
        "withheld",
        "source_error",
        "unparseable"
      ],
      "title": "AbsenceCode",
      "type": "string"
    },
    "AssetClass": {
      "enum": [
        "us_equity",
        "us_option",
        "crypto",
        "fixed_income"
      ],
      "title": "AssetClass",
      "type": "string"
    }
  },
  "$id": "urn:marketlens:schema:1:marketlens.Snapshot",
  "additionalProperties": false,
  "description": "The latest state of one stock or crypto pair. ``change`` and\n``change_pct`` are derived by the adapter against prev_close, from the\nprice ``change_basis`` names: the last trade while it falls in the latest\nsession, else that session's day_close.",
  "properties": {
    "absent": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/AbsenceCode"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Per-row reasons for None fields: field name -> AbsenceCode",
      "title": "Absent"
    },
    "ask_price": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ask Price",
      "x-unit": "price"
    },
    "ask_size": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ask Size",
      "x-unit": "by_asset_class"
    },
    "asset_class": {
      "$ref": "#/$defs/AssetClass"
    },
    "bid_price": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Bid Price",
      "x-unit": "price"
    },
    "bid_size": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Bid Size",
      "x-unit": "by_asset_class"
    },
    "change": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The change_basis price minus prev_close, in the row's currency",
      "title": "Change",
      "x-unit": "price"
    },
    "change_basis": {
      "anyOf": [
        {
          "enum": [
            "last_trade",
            "day_close"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The price change is measured from: last_trade while the last trade falls in the latest session (stocks: the day bar's regular hours, 09:30-16:00 New York; crypto: since the day bar began), else day_close, the session's change (after an extended-hours or a stale last trade)",
      "title": "Change Basis"
    },
    "change_pct": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "change / prev_close as a fraction (0.05 = 5 %)",
      "title": "Change Pct",
      "x-unit": "fraction"
    },
    "currency": {
      "default": "USD",
      "title": "Currency",
      "type": "string"
    },
    "day_close": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The latest session's daily bar close (stocks: regular hours)",
      "title": "Day Close",
      "x-unit": "price"
    },
    "day_high": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Day High",
      "x-unit": "price"
    },
    "day_low": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Day Low",
      "x-unit": "price"
    },
    "day_open": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The latest session's daily bar (today's, in progress while it trades)",
      "title": "Day Open",
      "x-unit": "price"
    },
    "day_volume": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Day Volume",
      "x-unit": "by_asset_class"
    },
    "day_vwap": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Day Vwap",
      "x-unit": "price"
    },
    "last_price": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The latest trade's price (may be an extended-hours or an old trade)",
      "title": "Last Price",
      "x-unit": "price"
    },
    "last_size": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Size",
      "x-unit": "by_asset_class"
    },
    "last_t": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "When the latest trade happened",
      "title": "Last T",
      "x-unit": "UTC"
    },
    "minute_close": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The latest minute bar's close",
      "title": "Minute Close",
      "x-unit": "price"
    },
    "minute_t": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Minute T",
      "x-unit": "UTC"
    },
    "prev_close": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The close of the session before day_*",
      "title": "Prev Close",
      "x-unit": "price"
    },
    "prev_volume": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prev Volume",
      "x-unit": "by_asset_class"
    },
    "quote_t": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Quote T",
      "x-unit": "UTC"
    },
    "t": {
      "description": "The newest timestamp among the snapshot's parts",
      "format": "date-time",
      "title": "T",
      "type": "string",
      "x-unit": "UTC"
    },
    "ticker": {
      "pattern": "^(?:[A-Z][A-Z0-9]{0,9}(?:-[A-Z0-9]{1,5})?|[A-Z0-9]{2,10}/[A-Z0-9]{2,10})$",
      "title": "Ticker",
      "type": "string"
    }
  },
  "required": [
    "ticker",
    "asset_class",
    "t"
  ],
  "title": "Snapshot",
  "type": "object",
  "x-schema-version": "1.1.0"
}
