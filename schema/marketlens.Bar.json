{
  "$defs": {
    "AbsenceCode": {
      "description": "Why a value is None. Never served as 0.",
      "enum": [
        "not_provided_by_source",
        "not_applicable",
        "not_entitled",
        "no_data",
        "insufficient_data",
        "not_recovered",
        "no_match",
        "withheld",
        "source_error",
        "unparseable"
      ],
      "title": "AbsenceCode",
      "type": "string"
    },
    "AssetClass": {
      "enum": [
        "us_equity",
        "us_option",
        "crypto",
        "fixed_income"
      ],
      "title": "AssetClass",
      "type": "string"
    }
  },
  "$id": "urn:marketlens:schema:1:marketlens.Bar",
  "additionalProperties": false,
  "description": "One OHLCV bar of a stock or a crypto pair.",
  "properties": {
    "absent": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/AbsenceCode"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Per-row reasons for None fields: field name -> AbsenceCode",
      "title": "Absent"
    },
    "asset_class": {
      "$ref": "#/$defs/AssetClass"
    },
    "close": {
      "title": "Close",
      "type": "number",
      "x-unit": "price"
    },
    "currency": {
      "default": "USD",
      "title": "Currency",
      "type": "string"
    },
    "high": {
      "title": "High",
      "type": "number",
      "x-unit": "price"
    },
    "low": {
      "title": "Low",
      "type": "number",
      "x-unit": "price"
    },
    "open": {
      "title": "Open",
      "type": "number",
      "x-unit": "price"
    },
    "t": {
      "description": "Bar start",
      "format": "date-time",
      "title": "T",
      "type": "string",
      "x-unit": "UTC"
    },
    "ticker": {
      "pattern": "^(?:[A-Z][A-Z0-9]{0,9}(?:-[A-Z0-9]{1,5})?|[A-Z0-9]{2,10}/[A-Z0-9]{2,10})$",
      "title": "Ticker",
      "type": "string"
    },
    "timeframe": {
      "pattern": "^(?:(?:[1-9]|[1-5][0-9])min|(?:[1-9]|1[0-9]|2[0-3])h|1d|1w|(?:1|2|3|4|6|12)mo)$",
      "title": "Timeframe",
      "type": "string"
    },
    "trade_count": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Trade Count",
      "x-unit": "count"
    },
    "volume": {
      "title": "Volume",
      "type": "number",
      "x-unit": "by_asset_class"
    },
    "vwap": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Vwap",
      "x-unit": "price"
    }
  },
  "required": [
    "ticker",
    "asset_class",
    "timeframe",
    "t",
    "open",
    "high",
    "low",
    "close",
    "volume"
  ],
  "title": "Bar",
  "type": "object",
  "x-schema-version": "1.0.0"
}
