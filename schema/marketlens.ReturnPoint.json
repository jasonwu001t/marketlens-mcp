{
  "$defs": {
    "AbsenceCode": {
      "description": "Why a value is None. Never served as 0.",
      "enum": [
        "not_provided_by_source",
        "not_applicable",
        "not_entitled",
        "no_data",
        "insufficient_data",
        "not_recovered",
        "no_match",
        "withheld",
        "source_error",
        "unparseable"
      ],
      "title": "AbsenceCode",
      "type": "string"
    }
  },
  "$id": "urn:marketlens:schema:1:marketlens.ReturnPoint",
  "additionalProperties": false,
  "properties": {
    "absent": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/AbsenceCode"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Per-row reasons for None fields: field name -> AbsenceCode",
      "title": "Absent"
    },
    "kind": {
      "enum": [
        "simple",
        "log"
      ],
      "title": "Kind",
      "type": "string"
    },
    "period": {
      "anyOf": [
        {
          "pattern": "^(?:(?:[1-9]|[1-5][0-9])min|(?:[1-9]|1[0-9]|2[0-3])h|1d|1w|(?:1|2|3|4|6|12)mo)$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Bucket the prices were sampled to (last price per bucket); None = consecutive rows",
      "title": "Period"
    },
    "price_column": {
      "title": "Price Column",
      "type": "string"
    },
    "ret": {
      "title": "Ret",
      "type": "number",
      "x-unit": "fraction"
    },
    "series": {
      "title": "Series",
      "type": "string"
    },
    "t": {
      "description": "End of the return's interval (the later observation, or the period bucket start)",
      "format": "date-time",
      "title": "T",
      "type": "string",
      "x-unit": "UTC"
    }
  },
  "required": [
    "series",
    "t",
    "ret",
    "kind",
    "price_column"
  ],
  "title": "ReturnPoint",
  "type": "object",
  "x-schema-version": "1.1.0"
}
