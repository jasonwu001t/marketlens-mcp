        },
        "settlement_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Settlement Type"
        },
        "ticker": {
          "anyOf": [
            {
              "pattern": "^(?:[A-Z][A-Z0-9]{0,9}(?:-[A-Z0-9]{1,5})?|[A-Z0-9]{2,10}/[A-Z0-9]{2,10})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ticker"
        },
        "type": {
          "enum": [
            "cash",
            "equity"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "amount"
      ],
      "title": "OptionDeliverable",
      "type": "object"
    },
    "OptionStyle": {
      "enum": [
        "american",
        "european"
      ],
      "title": "OptionStyle",
      "type": "string"
    },
    "OptionType": {
      "enum": [
        "call",
        "put"
      ],
      "title": "OptionType",
      "type": "string"
    }
  },
  "$id": "urn:marketlens:schema:1:marketlens.OptionContract",
