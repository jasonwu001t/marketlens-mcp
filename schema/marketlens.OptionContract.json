{
  "$defs": {
    "AbsenceCode": {
      "description": "Why a value is None. Never served as 0.",
      "enum": [
        "not_provided_by_source",
        "not_applicable",
        "not_entitled",
        "no_data",
        "insufficient_data",
        "not_recovered",
        "no_match",
        "withheld",
        "source_error",
        "unparseable"
      ],
      "title": "AbsenceCode",
      "type": "string"
    },
    "OptionDeliverable": {
      "additionalProperties": false,
      "properties": {
        "absent": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/AbsenceCode"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Per-row reasons for None fields: field name -> AbsenceCode",
          "title": "Absent"
        },
        "allocation_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Allocation Pct",
          "x-unit": "fraction"
        },
        "amount": {
          "description": "Shares (equity) or USD (cash) delivered per contract",
          "pattern": "^-?\\d+(\\.\\d+)?$",
          "title": "Amount",
          "type": "string",
          "x-unit": "by_asset_class"
        },
        "delayed_settlement": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delayed Settlement"
        },
        "settlement_method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
