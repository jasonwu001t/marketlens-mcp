{
  "$defs": {
    "AbsenceCode": {
      "description": "Why a value is None. Never served as 0.",
      "enum": [
        "not_provided_by_source",
        "not_applicable",
        "not_entitled",
        "no_data",
        "insufficient_data",
        "not_recovered",
        "no_match",
        "withheld",
        "source_error",
        "unparseable"
      ],
      "title": "AbsenceCode",
      "type": "string"
    }
  },
  "$id": "urn:marketlens:schema:1:marketlens.MostActive",
  "additionalProperties": false,
  "properties": {
    "absent": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/AbsenceCode"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Per-row reasons for None fields: field name -> AbsenceCode",
      "title": "Absent"
    },
    "as_of": {
      "description": "The screener's last update",
      "format": "date-time",
      "title": "As Of",
      "type": "string",
      "x-unit": "UTC"
    },
    "change": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Against the previous close, as market_snapshots computes it",
      "title": "Change",
      "x-unit": "price"
    },
    "change_basis": {
      "anyOf": [
        {
          "enum": [
            "last_trade",
            "day_close"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "As market_snapshots' change_basis: the price change is measured from",
      "title": "Change Basis"
    },
    "change_pct": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "change / previous close (0.05 = 5 %)",
      "title": "Change Pct",
      "x-unit": "fraction"
    },
    "price": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The latest trade, from the ticker's snapshot (market_snapshots' last_price)",
      "title": "Price",
      "x-unit": "price"
    },
    "rank": {
      "minimum": 1,
      "title": "Rank",
      "type": "integer"
    },
    "ranked_by": {
      "enum": [
        "volume",
        "trades"
      ],
      "title": "Ranked By",
      "type": "string"
    },
    "ticker": {
      "pattern": "^(?:[A-Z][A-Z0-9]{0,9}(?:-[A-Z0-9]{1,5})?|[A-Z0-9]{2,10}/[A-Z0-9]{2,10})$",
      "title": "Ticker",
      "type": "string"
    },
    "trade_count": {
      "title": "Trade Count",
      "type": "integer",
      "x-unit": "count"
    },
    "volume": {
      "title": "Volume",
      "type": "number",
      "x-unit": "shares"
    }
  },
  "required": [
    "ticker",
    "rank",
    "ranked_by",
    "volume",
    "trade_count",
    "as_of"
  ],
  "title": "MostActive",
  "type": "object",
  "x-schema-version": "1.1.0"
}
