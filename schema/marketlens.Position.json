{
  "$defs": {
    "AbsenceCode": {
      "description": "Why a value is None. Never served as 0.",
      "enum": [
        "not_provided_by_source",
        "not_applicable",
        "not_entitled",
        "no_data",
        "insufficient_data",
        "not_recovered",
        "no_match",
        "withheld",
        "source_error",
        "unparseable"
      ],
      "title": "AbsenceCode",
      "type": "string"
    },
    "AssetClass": {
      "enum": [
        "us_equity",
        "us_option",
        "crypto",
        "fixed_income"
      ],
      "title": "AssetClass",
      "type": "string"
    },
    "Environment": {
      "description": "Which brokerage account a portfolio read came from.",
      "enum": [
        "paper",
        "live"
      ],
      "title": "Environment",
      "type": "string"
    },
    "PositionSide": {
      "enum": [
        "long",
        "short"
      ],
      "title": "PositionSide",
      "type": "string"
    }
  },
  "$id": "urn:marketlens:schema:1:marketlens.Position",
  "additionalProperties": false,
  "properties": {
    "absent": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/AbsenceCode"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Per-row reasons for None fields: field name -> AbsenceCode",
      "title": "Absent"
    },
    "asset_class": {
      "$ref": "#/$defs/AssetClass"
    },
    "asset_marginable": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Asset Marginable"
    },
    "avg_entry_price": {
      "pattern": "^-?\\d+(\\.\\d+)?$",
      "title": "Avg Entry Price",
      "type": "string",
      "x-unit": "USD"
    },
    "change_today": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Change Today",
      "x-unit": "fraction"
    },
    "cost_basis": {
      "pattern": "^-?\\d+(\\.\\d+)?$",
      "title": "Cost Basis",
      "type": "string",
      "x-unit": "USD"
    },
    "current_price": {
      "anyOf": [
        {
          "pattern": "^-?\\d+(\\.\\d+)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Current Price",
      "x-unit": "USD"
    },
    "environment": {
      "$ref": "#/$defs/Environment"
    },
    "exchange": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Exchange"
    },
    "lastday_price": {
      "anyOf": [
        {
          "pattern": "^-?\\d+(\\.\\d+)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lastday Price",
      "x-unit": "USD"
    },
    "market_value": {
      "anyOf": [
        {
          "pattern": "^-?\\d+(\\.\\d+)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Market Value",
      "x-unit": "USD"
    },
    "occ_symbol": {
      "anyOf": [
        {
          "pattern": "^(?P<root>[A-Z]{1,6})(?P<yymmdd>\\d{6})(?P<cp>[CP])(?P<strike>\\d{8})$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Occ Symbol"
    },
    "provider_asset_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Asset Id"
    },
    "qty": {
      "pattern": "^-?\\d+(\\.\\d+)?$",
      "title": "Qty",
      "type": "string",
      "x-unit": "by_asset_class"
    },
    "qty_available": {
      "anyOf": [
        {
          "pattern": "^-?\\d+(\\.\\d+)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Qty Available",
      "x-unit": "by_asset_class"
    },
    "side": {
      "$ref": "#/$defs/PositionSide"
    },
    "ticker": {
      "pattern": "^(?:[A-Z][A-Z0-9]{0,9}(?:-[A-Z0-9]{1,5})?|[A-Z0-9]{2,10}/[A-Z0-9]{2,10})$",
      "title": "Ticker",
      "type": "string"
    },
    "unrealized_intraday_pl": {
      "anyOf": [
        {
          "pattern": "^-?\\d+(\\.\\d+)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unrealized Intraday Pl",
      "x-unit": "USD"
    },
    "unrealized_intraday_plpc": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unrealized Intraday Plpc",
      "x-unit": "fraction"
    },
    "unrealized_pl": {
      "anyOf": [
        {
          "pattern": "^-?\\d+(\\.\\d+)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unrealized Pl",
      "x-unit": "USD"
    },
    "unrealized_plpc": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unrealized Plpc",
      "x-unit": "fraction"
    }
  },
  "required": [
    "environment",
    "asset_class",
    "ticker",
    "side",
    "qty",
    "avg_entry_price",
    "cost_basis"
  ],
  "title": "Position",
  "type": "object",
  "x-schema-version": "1.0.0"
}
