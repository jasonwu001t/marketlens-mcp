{
  "$defs": {
    "AbsenceCode": {
      "description": "Why a value is None. Never served as 0.",
      "enum": [
        "not_provided_by_source",
        "not_applicable",
        "not_entitled",
        "no_data",
        "insufficient_data",
        "not_recovered",
        "no_match",
        "withheld",
        "source_error",
        "unparseable"
      ],
      "title": "AbsenceCode",
      "type": "string"
    }
  },
  "$id": "urn:marketlens:schema:1:marketlens.Mover",
  "additionalProperties": false,
  "properties": {
    "absent": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/AbsenceCode"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Per-row reasons for None fields: field name -> AbsenceCode",
      "title": "Absent"
    },
    "as_of": {
      "format": "date-time",
      "title": "As Of",
      "type": "string",
      "x-unit": "UTC"
    },
    "change": {
      "title": "Change",
      "type": "number",
      "x-unit": "price"
    },
    "direction": {
      "enum": [
        "gainer",
        "loser"
      ],
      "title": "Direction",
      "type": "string"
    },
    "market_type": {
      "enum": [
        "stocks",
        "crypto"
      ],
      "title": "Market Type",
      "type": "string"
    },
    "percent_change": {
      "description": "Alpaca reports percent; the adapter divides by 100",
      "title": "Percent Change",
      "type": "number",
      "x-unit": "fraction"
    },
    "price": {
      "title": "Price",
      "type": "number",
      "x-unit": "price"
    },
    "rank": {
      "minimum": 1,
      "title": "Rank",
      "type": "integer"
    },
    "ticker": {
      "pattern": "^(?:[A-Z][A-Z0-9]{0,9}(?:-[A-Z0-9]{1,5})?|[A-Z0-9]{2,10}/[A-Z0-9]{2,10})$",
      "title": "Ticker",
      "type": "string"
    }
  },
  "required": [
    "ticker",
    "market_type",
    "direction",
    "rank",
    "price",
    "change",
    "percent_change",
    "as_of"
  ],
  "title": "Mover",
  "type": "object",
  "x-schema-version": "1.1.0"
}
