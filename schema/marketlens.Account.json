{
  "$defs": {
    "AbsenceCode": {
      "description": "Why a value is None. Never served as 0.",
      "enum": [
        "not_provided_by_source",
        "not_applicable",
        "not_entitled",
        "no_data",
        "insufficient_data",
        "not_recovered",
        "no_match",
        "withheld",
        "source_error",
        "unparseable"
      ],
      "title": "AbsenceCode",
      "type": "string"
    },
    "Environment": {
      "description": "Which brokerage account a portfolio read came from.",
      "enum": [
        "paper",
        "live"
      ],
      "title": "Environment",
      "type": "string"
    }
  },
  "$id": "urn:marketlens:schema:1:marketlens.Account",
  "additionalProperties": false,
  "description": "Balances and status. The account number is masked to its last four\ncharacters (``****1234``); the full number is never served (withheld).",
  "properties": {
    "absent": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/AbsenceCode"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Per-row reasons for None fields: field name -> AbsenceCode",
      "title": "Absent"
    },
    "account_blocked": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Account Blocked"
    },
    "account_id": {
      "description": "The provider's opaque account id",
      "title": "Account Id",
      "type": "string"
    },
    "account_number_masked": {
      "anyOf": [
        {
          "type": "string"
        },
