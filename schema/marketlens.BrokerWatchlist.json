{
  "$defs": {
    "AbsenceCode": {
      "description": "Why a value is None. Never served as 0.",
      "enum": [
        "not_provided_by_source",
        "not_applicable",
        "not_entitled",
        "no_data",
        "insufficient_data",
        "not_recovered",
        "no_match",
        "withheld",
        "source_error",
        "unparseable"
      ],
      "title": "AbsenceCode",
      "type": "string"
    },
    "Environment": {
      "description": "Which brokerage account a portfolio read came from.",
      "enum": [
        "paper",
        "live"
      ],
      "title": "Environment",
      "type": "string"
    }
  },
  "$id": "urn:marketlens:schema:1:marketlens.BrokerWatchlist",
  "additionalProperties": false,
  "description": "A watchlist kept at the broker (not a product list). ``tickers`` is\nNone on the list endpoint (not_provided_by_source).",
  "properties": {
    "absent": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/AbsenceCode"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Per-row reasons for None fields: field name -> AbsenceCode",
      "title": "Absent"
    },
    "created_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Created At",
      "x-unit": "UTC"
    },
    "environment": {
      "$ref": "#/$defs/Environment"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "tickers": {
      "anyOf": [
        {
          "items": {
            "pattern": "^(?:[A-Z][A-Z0-9]{0,9}(?:-[A-Z0-9]{1,5})?|[A-Z0-9]{2,10}/[A-Z0-9]{2,10})$",
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tickers"
    },
    "updated_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Updated At",
      "x-unit": "UTC"
    },
    "watchlist_id": {
      "title": "Watchlist Id",
      "type": "string"
    }
  },
  "required": [
    "environment",
    "watchlist_id",
    "name"
  ],
  "title": "BrokerWatchlist",
  "type": "object",
  "x-schema-version": "1.1.0"
}
